# ==============================================================================
# PROJECT OUROBOROS: ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env and configure secrets locally.
# Never commit your actual .env file or API keys to version control.

# Core Application
APP_ENV=development
APP_NAME="Project Ouroboros"
HOST=127.0.0.1
PORT=8000
LOG_LEVEL=INFO
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"
DATABASE_URL="sqlite:///./ouroboros.db"

# Target Repository Paths (Windows paths supported with or without spaces)
DEFAULT_REPO_PATH="E:\\MM Office\\Agent Chess"
NAVIGATOR_PATH="E:\\MM Office\\Meta-Graph-Codebase-Navigator"
NAVIGATOR_API_URL="http://localhost:8001"

# Local Inference Runtime (Ollama / CPU-Quantized)
# Hardware Guardrail: Default to 1 active model on Intel HD 620 / 8GB RAM
OLLAMA_BASE_URL="http://localhost:11434"
LOCAL_MODEL_NAME="qwen2.5-coder:1.5b"
LOCAL_MODEL_CONTEXT_TOKENS=2048
LOCAL_MODEL_KEEP_ALIVE="5m"
MAX_LOCAL_CONCURRENCY=1
AUTO_DOWNLOAD_LOCAL_MODELS=false

# Remote Provider (Groq API)
# Enter your Groq API key in .env (never commit .env)
GROQ_API_KEY=""
GROQ_REASONING_MODEL="llama-3.3-70b-versatile"
GROQ_FAST_MODEL="llama-3.1-8b-instant"

# Routing & Fallback Policies
ALLOW_REMOTE_FALLBACK=true
REQUIRE_FALLBACK_CONFIRMATION=false
STRICT_LOCAL_ONLY=false

# Swarm Guardrails & Resource Limits (8 GB RAM System Limits)
MAX_REPAIR_ATTEMPTS=3
MAX_TICKETS_PER_BATCH=1
MAX_CONCURRENT_TESTS=1
MEMORY_WARNING_THRESHOLD_MB=1500
SUBPROCESS_TIMEOUT_SECONDS=60
MAX_OUTPUT_CAPTURE_BYTES=65536

# Execution Security & Sandbox Policy ('auto', 'docker', 'restricted_local', 'fail_closed')
SANDBOX_MODE="auto"
REQUIRE_CONTAINER_SANDBOX=false
ISOLATED_WORKTREE_DIR="./worktrees"
AUTONOMY_MODE="SUPERVISED"

# Arize Phoenix AI Observability & Tracing Privacy
PHOENIX_ENABLED=true
PHOENIX_PORT=6006
PHOENIX_PROJECT_NAME="ouroboros-swarm"
PHOENIX_COLLECTOR_ENDPOINT=""
PHOENIX_CAPTURE_PROMPTS=false
PHOENIX_MASK_CODE_SNIPPETS=true
