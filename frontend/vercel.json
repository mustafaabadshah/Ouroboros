{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://ouroboros-backend-i9x2.onrender.com/api/:path*"
    },
    {
      "source": "/phoenix",
      "destination": "https://ouroboros-backend-i9x2.onrender.com/phoenix"
    },
    {
      "source": "/observability",
      "destination": "https://ouroboros-backend-i9x2.onrender.com/observability"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
